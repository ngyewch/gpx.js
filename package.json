{
  "name": "@ngyewch/gpx",
  "version": "0.1.0",
  "description": "GPX parser",
  "license": "MIT",
  "homepage": "http://ngyewch.github.io/gpx.js/",
  "keywords": [
    "gpx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngyewch/gpx.js.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "script": "./dist/gpx.umd.cjs",
      "types": "./dist/gpx.d.ts",
      "import": "./dist/gpx.js",
      "require": "./dist/gpx.umd.cjs"
    }
  },
  "module": "./dist/gpx.js",
  "main": "./dist/gpx.umd.cjs",
  "types": "./dist/gpx.d.ts",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "postbuild": "validate-package-exports --check --verify",
    "prepublishOnly": "validate-package-exports --check --verify",
    "test": "tap",
    "lint": "eslint src/ test/",
    "typedoc": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tapjs/core": "4.0.4",
    "eslint": "9.39.1",
    "eslint-plugin-jsdoc": "61.2.1",
    "gh-pages": "6.3.0",
    "globals": "16.5.0",
    "tap": "21.1.3",
    "typedoc": "0.28.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "validate-package-exports": "0.14.0",
    "vite": "7.2.2",
    "vite-plugin-dts": "4.5.4"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.2",
    "date-fns": "4.1.0"
  },
  "files": [
    "dist/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
