{
  "name": "@ngyewch/gpx",
  "version": "0.1.0",
  "description": "GPX parser",
  "license": "MIT",
  "homepage": "http://ngyewch.github.io/gpx.js/",
  "keywords": [
    "gpx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngyewch/gpx.js.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "script": "./dist/gpx.umd.cjs",
      "types": "./dist/gpx.d.ts",
      "import": "./dist/gpx.js",
      "require": "./dist/gpx.umd.cjs"
    }
  },
  "module": "./dist/gpx.js",
  "main": "./dist/gpx.umd.cjs",
  "types": "./dist/gpx.d.ts",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "postbuild": "validate-package-exports --check",
    "prepublishOnly": "validate-package-exports --check",
    "test": "tap",
    "lint": "eslint src/ test/",
    "typedoc": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tapjs/core": "4.5.8",
    "eslint": "10.4.1",
    "eslint-plugin-jsdoc": "63.0.1",
    "gh-pages": "6.3.0",
    "globals": "17.6.0",
    "tap": "21.7.4",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "validate-package-exports": "1.0.0",
    "vite": "8.0.16",
    "vite-plugin-dts": "5.0.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.10",
    "date-fns": "4.4.0"
  },
  "files": [
    "dist/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
